# ─── Application form ───────────────────────────────────────────
# Choose one: google | formspree | none
NEXT_PUBLIC_FORM_PROVIDER=google

# ── Option A: Google Forms (free, unlimited, lands in a Sheet) ──
# From your form's share link: .../forms/d/e/<THIS_PART>/viewform
NEXT_PUBLIC_GOOGLE_FORM_ID=
# Field ids — see SETUP-FORM.md for how to find them
NEXT_PUBLIC_GF_NAME=entry.
NEXT_PUBLIC_GF_EMAIL=entry.
NEXT_PUBLIC_GF_PROGRAM=entry.
NEXT_PUBLIC_GF_BACKGROUND=entry.
NEXT_PUBLIC_GF_GOAL=entry.
NEXT_PUBLIC_GF_GITHUB=entry.

# ── Option B: Formspree (50 free/month, emails you) ─────────────
# formspree.io → new form → copy the id from the endpoint URL
NEXT_PUBLIC_FORMSPREE_ID=
